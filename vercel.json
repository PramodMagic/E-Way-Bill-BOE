{
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key":"Content-Security-Policy","value":"default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; img-src 'self' data:; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"},
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), interest-cohort=()"},
      {"key":"Strict-Transport-Security","value":"max-age=63072000; includeSubDomains"},
      {"key":"X-Robots-Tag","value":"noindex, nofollow, noarchive"},
      {"key":"Cache-Control","value":"no-store"}
    ]
  }]
}
